# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe platform / Connect
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LIFF (LINE Front-end Framework) — フロント公開可（LINE連携・通知用）
NEXT_PUBLIC_LIFF_ID=

# LINE Login (OAuth) — サーバー専用（任意連携）
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=http://localhost:3000/api/auth/line/callback

# LINE Messaging API — サーバー専用（通知機能用・将来利用）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
